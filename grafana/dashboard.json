{
  "dashboard": {
    "title": "Polymarket BTC 15 mins Trading Bot",
    "timezone": "browser",
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Total Trades",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_live_trades_total",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Winning Trades",
        "type": "stat",
        "gridPos": {
          "x": 3,
          "y": 0,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_live_winning_trades_total",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Losing Trades",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_live_losing_trades_total",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Win Rate",
        "type": "gauge",
        "gridPos": {
          "x": 9,
          "y": 0,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_live_win_rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 40
                },
                {
                  "color": "green",
                  "value": 60
                }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Wallet Balance",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_wallet_balance_usdc",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 6,
        "title": "Realized P&L",
        "type": "stat",
        "gridPos": {
          "x": 3,
          "y": 3,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_live_realized_pnl",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 0
                }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Inventory (shares)",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 3,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_live_inventory_shares",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Open Positions",
        "type": "stat",
        "gridPos": {
          "x": 9,
          "y": 3,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_live_open_positions",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Orders (placed / filled / rejected)",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 6,
          "w": 6,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_orders_placed_total",
            "legendFormat": "Placed",
            "refId": "A"
          },
          {
            "expr": "trading_orders_filled_total",
            "legendFormat": "Filled",
            "refId": "B"
          },
          {
            "expr": "trading_orders_rejected_total",
            "legendFormat": "Rejected",
            "refId": "C"
          }
        ]
      },
      {
        "id": 10,
        "title": "Risk Utilization",
        "type": "gauge",
        "gridPos": {
          "x": 6,
          "y": 6,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_risk_utilization",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 60
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Max Drawdown",
        "type": "stat",
        "gridPos": {
          "x": 9,
          "y": 6,
          "w": 3,
          "h": 3
        },
        "targets": [
          {
            "expr": "trading_max_drawdown",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 12,
        "title": "P&L and Balance Over Time",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 9,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "trading_live_realized_pnl",
            "legendFormat": "Realized PnL",
            "refId": "A"
          },
          {
            "expr": "trading_wallet_balance_usdc",
            "legendFormat": "Wallet Balance",
            "refId": "B"
          }
        ]
      }
    ]
  },
  "overwrite": true
}