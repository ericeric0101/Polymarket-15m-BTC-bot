# Example environment template (66 keys; operator overrides and advanced reference values).
#
# Strategy defaults and advanced diagnostics live in
# config/profiles/btc15_twap_v3.env. Keep wallet secrets only in local .env.

STRATEGY_PROFILE=btc15_twap_v3

# Credentials and venue connection
POLYMARKET_PK=
POLYMARKET_FUNDER=
POLYGON_RPC_URL=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Settlement reference and lifecycle
POLYMARKET_CHAINLINK_TWAP_ENABLED=1
POLYMARKET_CHAINLINK_TWAP_WINDOW_SEC=60
POLYMARKET_CHAINLINK_TWAP_SILENCE_RECONNECT_SEC=15
REQUIRE_TWAP_REFERENCE_SPOT=1
TWAP_DEGRADED_BLOCK_NEW_ENTRIES=1
QUOTE_STALE_SEC=30
QUOTE_MAX_DELIVERY_DELAY_SEC=2
QUOTE_RESUBSCRIBE_GRACE_SEC=12
# Bounded DataEngine L2 top-N snapshot cadence per instrument (min 0.05 sec).
POLYMARKET_L2_PUBLISH_INTERVAL_SEC=0.25
AUTO_NODE_ROLLOVER_ENABLED=1

# Five-layer entry decision
ENTRY_SCORE_MIN=0.20
FIRST_ENTRY_SCORE_MIN=0.22
FIRST_ENTRY_MAX_TIME_LEFT_SEC=600
ENTRY_MIN_TIME_LEFT_SEC=60
ENTRY_MAX_FAIR_PRICE=0.90
EXTERNAL_CONFIRMATION_ENABLED=1
EXTERNAL_CONFLICT_BOOK_MID_THRESHOLD_PS=0.02
EXTERNAL_CONFLICT_ACTION=skip
ENTRY_MIN_ROBUST_NET_USDC=0.001
EXECUTION_COST_LOOKBACK_HOURS=168
EXECUTION_COST_MIN_SAMPLES=30

# Execution and per-market exposure
MARKET_TARGET_SHARES=10
HIGH_PRICE_THRESHOLD=0.70
HIGH_PRICE_TARGET_SHARES=5.5
MARKET_MAX_POSITION_SHARES=10
# share_v1: BUY quantity = min(share target, risk budget, visible L2 fraction,
# inventory headroom); price <= HIGH_PRICE_THRESHOLD -> MARKET_TARGET_SHARES,
# above -> HIGH_PRICE_TARGET_SHARES; below 5.5 shares the entry is skipped.
# LIVE refuses to start if targets leave [5.5, 10] or the threshold is not 0.70.
DEPTH_RISK_SIZING_ENABLED=1
DEPTH_RISK_MAX_ENTRY_NOTIONAL_USDC=10
DEPTH_RISK_MAX_LOSS_USDC=10
DEPTH_RISK_DEPTH_FRACTION=0.10
DEPTH_RISK_PRICE_BOUNDARY_TICKS=2
DEPTH_RISK_SHADOW_ENABLED=1
DEPTH_RISK_SHADOW_INTERVAL_SEC=15
# One successful BUY entry per market is a hard safety invariant.
ORDER_POST_ONLY=1
ORDER_TTL_SEC=20
ORDER_REQUOTE_MIN_AGE_SEC=6
ORDER_REQUOTE_HYSTERESIS_TICKS=1

# Exit and redemption authority
HOLD_TO_REDEEM=1
STOP_LOSS_ENABLED=0
RECOVERY_EXIT_ENABLED=1
RECOVERY_EXIT_REQUIRE_TWAP_CONFIRMATION=1
RECOVERY_EXIT_MAX_TIME_LEFT_SEC=720
RECOVERY_EXIT_MIN_HOLD_SEC=120
AUTO_REDEEM_ENABLED=1

# Observability and research
TRADE_DB_ENABLED=1
TRADE_DB_PATH=./data/trading/trade_journal.db
# Optional verified mirror of data/journal_archive (e.g. an external disk). Empty = no mirror.
# A missing/unmounted path never blocks the local archive and nothing is ever deleted there.
# JOURNAL_ARCHIVE_MIRROR_DIR=/Volumes/<disk>/polymarket-journal-archive
# Observer-only BTC 1-second Parquet history; reuses the existing Binance aggTrade feed.
BTC_1S_HISTORY_ENABLED=1
BTC_1S_HISTORY_DIR=data/btc_history_1s
BTC_1S_HISTORY_MIN_FREE_DISK_GB=5
DASHBOARD_THEME=light
TERMINAL_DASHBOARD=0
FAIR_EDGE_BUCKET_SHADOW_ENABLED=1
SHADOW_SIMULATION_ENABLED=1
# Persistent BUY-only realized-PnL session guard (Asia/Taipei). SELL, stop,
# reconciliation and redeem paths remain available after a lock.
# `legacy` is the current deployed behavior. V2 is prepared but must only be
# enabled on a controlled restart after review; it never changes position size.
SESSION_PNL_GUARD_MODE=legacy
# Future V2 candidate (requires a positive value when mode is target_scaled_v2):
# MONTHLY_NET_TARGET_USDC=500
SESSION_PNL_GUARD_ENABLED=1
# Legacy-mode-only fixed thresholds:
SESSION_PROFIT_ARM_USDC=8.0
SESSION_PROFIT_DRAWDOWN_USDC=4.0
SESSION_HARD_PROFIT_LOCK_ENABLED=0
SESSION_HARD_PROFIT_LOCK_USDC=10.0
SESSION_MAX_LOSS_ENABLED=1
SESSION_MAX_LOSS_USDC=8.0
# Research-only official-TWAP forward telemetry. Raw per-second persistence is
# intentionally disabled; the live bot uses only bounded in-memory samples.
TWAP_RAW_RETENTION_ENABLED=0
TWAP_RAW_RETENTION_DAYS=7
TWAP_RESEARCH_MAX_DB_MB=500
TWAP_RESEARCH_MIN_FREE_DISK_GB=10
# Dedicated bounded store for TWAP-forward shadow evidence.  It must not share
# the high-volume Outcome/lead-lag research database.
TWAP_RESEARCH_DB_PATH=data/research/twap_forward_shadow.db
STARTUP_VERBOSE=0

# Outcome fast-follow safety. The live profile currently uses live_entry_only.
OUTCOME_LEAD_LAG_MODE=live_entry_only
OUTCOME_LEAD_LAG_MAX_RETURN_INTERVAL_MS=6000
# Research-only Hyperliquid BTC BBO/L2Book probe; never has signal authority.
OUTCOME_HIGH_FREQUENCY_SHADOW_ENABLED=0
OUTCOME_BYPASS_EXECUTION_PENALTY=0
