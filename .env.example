# Polymarket BTC 15-minute bot environment example.
#
# Private credentials, wallet addresses, and private network endpoints are
# intentionally omitted. Keep them only in your local .env.

# =========================
# Public Polymarket config
# =========================
POLYMARKET_PK=
POLYMARKET_WALLET_ADDRESS=
POLYGON_RPC_URL=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CTF_COLLATERAL_TOKEN=PUSD
POLY_BUILDER_CODE=

# =========================
# Market discovery / lifecycle
# =========================
GAMMA_DISCOVERY_TIMEOUT_SEC=8
BTC_MARKET_LOOKBACK_INTERVALS=1
BTC_MARKET_LOOKAHEAD_INTERVALS=4
BTC_MARKET_LOAD_SLUG_COUNT=6
BTC_MARKET_END_WINDOW_BACK_MINUTES=5
BTC_MARKET_END_WINDOW_FORWARD_MINUTES=120
MARKET_SETTLING_GRACE_SEC=15
MARKET_NEXT_POLL_SEC=15
MARKET_WAITING_MAX_MISSES=3

# =========================
# Runtime / observability
# =========================
STARTUP_VERBOSE=0
NAUTILUS_COMPAT_PATCH_MODE=runtime
AUTO_APPLY_NAUTILUS_PATCH=1
NAUTILUS_LOG_LEVEL=ERROR
AUTO_NODE_ROLLOVER_ENABLED=1
AUTO_NODE_ROLLOVER_SEC=3600
AUTO_NODE_ROLLOVER_COOLDOWN_SEC=3
AUTO_NODE_ROLLOVER_MAX_FAILURES=5
AUTO_NODE_RESTART_ON_UNEXPECTED_EXIT=0
TRADE_DB_ENABLED=1
TRADE_DB_PATH=./logs/trade_journal.db
# Dry-run only: one passive-maker simulation per market, filled when a later ask reaches its limit.
SHADOW_SIMULATION_ENABLED=1
SHADOW_SIMULATION_FILL_TIMEOUT_SEC=90
# Shadow samples stay collected at all ages; reports segment Fresh / Aged / Stale.
SHADOW_SIMULATION_MAX_QUOTE_AGE_SEC=2.0
SHADOW_SIMULATION_AGED_QUOTE_MAX_AGE_SEC=30.0
TERMINAL_DASHBOARD=0
TERMINAL_DASHBOARD_REFRESH_SEC=1.0
DASHBOARD_THEME=light
STRATEGY_STATUS_INTERVAL_SEC=30
NO_QUOTE_DIAG_INTERVAL_SEC=30
REBATE_REPORT_DIR=./logs/rebate

# =========================
# Maker sizing / quote basics
# =========================
MAKER_MODE=1
MAKER_QUOTE_SIDES=both
MAKER_QUOTE_REFRESH_SEC=3
MAKER_HALF_SPREAD=0.012
MAKER_QUOTE_SIZE_USDC=1.0
MAKER_MIN_SHARES=5
MAKER_EXCHANGE_MIN_SHARES=5
MAKER_FIXED_SHARES=10.8
MAKER_MAX_ORDER_USDC=12.0
MAKER_MAX_INVENTORY_SHARES=12
MAX_LOCKED_SIDE_POSITION=12
INVENTORY_FULL_BEHAVIOR=STOP_BUY
MAKER_KILL_SWITCH_RESET_ON_ROLLOVER=1
MARKET_MAX_BUY_EVENTS_PER_MARKET=2
MAKER_POST_ONLY=0
MAKER_POST_ONLY_STRICT=0
MAKER_MIN_EXPECTED_NET_USDC=0.002
MAKER_ADVERSE_SELECTION_BUFFER=0.001
MAKER_ORDER_TTL_SEC=20
MAX_REQUOTE_PER_SEC=1.0
REQUOTE_HYSTERESIS_TICKS=1
MAKER_REQUOTE_MIN_AGE_SEC=12
MAKER_BUY_PLANNED_QUOTE_MAX_AGE_SEC=10.0
MAKER_GATE_BLOCK_GRACE_SEC=4
MAKER_CANCEL_MAX_RETRIES=3
MAKER_CANCEL_COOLDOWN_SEC=2
MAKER_CANCEL_ACK_TIMEOUT_SEC=8
MAKER_CANCEL_ACK_DEDUPE_WINDOW_SEC=3
MAKER_MAX_CONSECUTIVE_DENIED=5
MAKER_BALANCE_PAUSE_SEC=30
MAKER_ERROR_PAUSE_SEC=30

# =========================
# Entry gates
# =========================
DIRECTIONAL_ENTRY_MIN_SCORE_ABS_NEW=0.20
DIRECTIONAL_FIRST_ENTRY_MIN_SCORE_ABS_NEW=0.20
ENTRY_FAIR_EDGE_MIN_PS=0.00
# First entries are allowed only from 3 minutes to 10 minutes before expiry.
# Existing inventory can still be managed normally.
FIRST_ENTRY_MAX_TIME_LEFT_SEC=600
# Raw digital probabilities are shrunk toward executable market mid before
# edge gates. DOWN uses a lower model weight due to observed overconfidence.
PROBABILITY_CALIBRATION_ENABLED=1
PROBABILITY_CALIBRATION_UP_MODEL_WEIGHT=0.65
PROBABILITY_CALIBRATION_DOWN_MODEL_WEIGHT=0.35
# Disabled by default: a small account's statistically justified Kelly order
# can be below Polymarket's minimum, in which case the bot correctly skips it.
KELLY_SIZING_ENABLED=0
KELLY_SIZING_FRACTION=0.25
KELLY_SIZING_MAX_COLLATERAL_FRACTION=0.10
ENTRY_SPOT_STRIKE_LOOKBACK_SEC=0
ENTRY_SPOT_STRIKE_AVG_MIN_ABS=0
DOWN_HIGH_PRICE_THRESHOLD=0.72
DOWN_HIGH_PRICE_MIN_SCORE_ABS=0.30
DOWN_HIGH_PRICE_MIN_ROBUST_NET_USDC=0.03
DOWN_HIGH_PRICE_SPOT_STRIKE_AVG_MAX=-5
MAKER_DIRECTIONAL_EDGE_GATE_ENABLED=1
MAKER_MIN_DIRECTIONAL_EDGE_PS=0.01
MAKER_MIN_DIRECTIONAL_EDGE_PS_DOWN=0.01
MAKER_MIN_DIRECTIONAL_EDGE_PS_CONSERVATIVE=0.02
MAKER_MIN_MINUTES_TO_CLOSE=3.0
MAKER_MIN_FAIR_PRICE=0.20
MAKER_MAX_FAIR_PRICE=0.90
MAKER_REDUCE_ONLY_NO_NEW_SELL_LAST_SEC=60
MAKER_EARLY_SELL_ONLY_SEC=120
MAKER_MOMENTUM_BUY_FILTER_PCT=0.04
MAKER_MOMENTUM_SELL_FILTER_PCT=0.02
MAKER_MOMENTUM_WINDOW_TICKS=20
CONTINUATION_ENTRY_ENABLED=1
CONTINUATION_ENTRY_SIZE_MULTIPLIER=1.0
TREND_BUY_ENABLED=1
TREND_BUY_MIN_SCORE=0.20
TREND_BUY_MIN_NET_USDC=-0.005
TREND_BUY_PENALTY_DISCOUNT=0.50
TREND_BUY_MIN_TIME_LEFT_SEC=300
TREND_BUY_MAX_PRICE_PREMIUM_PS=0.02
TREND_BUY_SIZE_MULTIPLIER=1.0

# Smart money confirmation starts shadow-only. Set SMART_MONEY_ENABLED=1 only
# after comparing SMART_MONEY_OBSERVATION rows against realized PnL.
SMART_MONEY_ENABLED=0
SMART_MONEY_SHADOW_ENABLED=1
SMART_MONEY_MIN_CASH_FILTER=10
SMART_MONEY_POLL_INTERVAL_SEC=3
SMART_MONEY_RECENT_WINDOW_SEC=180
SMART_MONEY_STALE_AFTER_SEC=12
SMART_MONEY_FOMO_CUTOFF_SEC=120
SMART_MONEY_ENTRY_THRESHOLD=0.62
SMART_MONEY_MIN_DIRECTIONAL_WALLETS=2
SMART_MONEY_CONFLICT_SIZE_MULTIPLIER=0.5
SMART_MONEY_SKIP_STRONG_CONFLICT=0
SMART_MONEY_POSITION_REFRESH_SEC=30
SMART_MONEY_HEDGE_RATIO=0.25
SMART_MONEY_BOT_SIZE_CV_THRESHOLD=0.05
SMART_MONEY_MIN_WALLET_TRADES=3
SMART_MONEY_DIRECTIONAL_MIN_CASH=20
SMART_MONEY_WALLET_DB_PATH=./logs/smart_money_wallets.db
SMART_MONEY_WALLET_LABEL_CACHE_TTL_SEC=60
SMART_MONEY_WEIGHT_SMART=2.0
SMART_MONEY_WEIGHT_DIRECTIONAL=1.0
SMART_MONEY_WEIGHT_UNKNOWN=0.25

# =========================
# Side decision / bi-side
# =========================
BI_SIDE_ENABLED=1
BI_SIDE_DEFAULT_MODE=NONE
BI_SIDE_DECISION_MODE=boundary_only
BI_SIDE_DECISION_GRACE_SEC=60
BI_SIDE_LOCK_UNTIL_REDUCE_ONLY=1
BI_SIDE_ALLOW_INTRAMARKET_FLIP=1
BI_SIDE_FLIP_CONFIRMATIONS=2
BI_SIDE_FLIP_CONFIRMATIONS_HELD_NEW=4
BI_SIDE_FLIP_MIN_PERSIST_SEC_HELD_NEW=8
BI_SIDE_MIN_TIME_LEFT_SEC=180
BI_SIDE_REEVAL_INTERVAL_SEC=1.0
BI_SIDE_LOG_INTERVAL_SEC=15.0
BI_SIDE_SKIP_LOG_INTERVAL_SEC=10.0
BI_SIDE_MIN_SCORE_UP=0.20
BI_SIDE_MAX_SCORE_DOWN=-0.20
BI_SIDE_FLIP_MIN_SCORE_UP_NEW=0.20
BI_SIDE_FLIP_MAX_SCORE_DOWN_NEW=-0.20
BI_SIDE_FLIP_MIN_SCORE_UP_HELD_NEW=0.18
BI_SIDE_FLIP_MAX_SCORE_DOWN_HELD_NEW=-0.18
BI_SIDE_FLIP_FAIR_INVERSION_MIN_PS=0.03
BI_SIDE_DOWN_SIZE_MULT=1.0
SIDE_SIGNAL_THRESHOLD_UP=0.05
SIDE_SIGNAL_THRESHOLD_DOWN=0.05
SIDE_SIGNAL_MIN_CONFIDENCE=0.15
SIDE_SIGNAL_BTC_EMA_FAST_SEC=12
SIDE_SIGNAL_BTC_EMA_SLOW_SEC=45
SIDE_SIGNAL_MID_EMA_FAST_SEC=12
SIDE_SIGNAL_MID_EMA_SLOW_SEC=45
SIDE_SIGNAL_BTC_TREND_NORM_PCT=0.0005
SIDE_SIGNAL_MID_VELOCITY_REVERSAL=0.010
SIDE_THESIS_WEAK_SCORE_ABS_NEW=0.20
SIDE_THESIS_WEAK_REQUIRES_OPPOSITE_SIDE_NEW=1
SIDE_THESIS_WEAK_OPPOSITE_SCORE_ABS_NEW=0.18
SIDE_THESIS_WEAK_CONFIRMATIONS_NEW=3
SIDE_THESIS_WEAK_MIN_HOLD_SEC_NEW=45

# =========================
# Fair pricing / spot / strike
# =========================
MAKER_FAIR_PRICER_MODE=digital
EXTERNAL_SPOT_TIMEOUT_SEC=2.5
EXTERNAL_SPOT_MAX_FAILURES=8
EXTERNAL_SPOT_HISTORY_MAX=1200
EXTERNAL_SPOT_SOURCE_DELTA_ABS_MAX_USD=40
POLYMARKET_CHAINLINK_HISTORY_MAX=1200
POLYMARKET_CHAINLINK_TWAP_ENABLED=1
POLYMARKET_CHAINLINK_TWAP_WINDOW_SEC=60
POLYMARKET_CHAINLINK_TWAP_SYMBOL=btc/usd
REQUIRE_TWAP_REFERENCE_SPOT=1
MAKER_DIGITAL_VOL_WINDOW=120
MAKER_DIGITAL_VOL_MIN_POINTS=20
MAKER_DIGITAL_SIGMA_DEFAULT=0.60
MAKER_DIGITAL_SIGMA_FLOOR=0.20
MAKER_DIGITAL_SIGMA_CEILING=1.60
MAKER_DIGITAL_VOL_SCALE=1.00
MAKER_DIGITAL_SIGMA_TIME_DECAY=1
MAKER_DIGITAL_SIGMA_TIME_DECAY_REF_SEC=600
MAKER_DIGITAL_SIGMA_TIME_DECAY_MIN=0.30
MAKER_DIGITAL_IMPLIED_SIGMA_ENABLED=1
MAKER_DIGITAL_IMPLIED_SIGMA_WEIGHT=0.50
MARKET_STRIKE_ANCHOR_MAX_LAG_SEC=180
MARKET_STRIKE_ANCHOR_NEAR_SEC=30
MARKET_STRIKE_REST_RETRY_SEC=60
MARKET_STRIKE_GAMMA_VALIDATE_INTERVAL_SEC=180
MARKET_STRIKE_GAMMA_WARN_ABS_USD=5
MARKET_STRIKE_GAMMA_WARN_INTERVAL_SEC=120
STRIKE_FALLBACK_LOG_INTERVAL_SEC=60

# =========================
# Execution penalty / orderbook / fees
# =========================
MAKER_EXECUTION_PENALTY_ENABLE=1
MAKER_EXECUTION_PENALTY_FLOOR_USDC=0.001
MAKER_EXECUTION_SLIPPAGE_SPREAD_MULT=0.02
MAKER_EXECUTION_NON_ATOMIC_VOL_MULT=0.01
MAKER_EXECUTION_DEPTH_IMPACT_MULT=0.05
MAKER_EXECUTION_VWAP_MULT=0.02
MAKER_BUY_TAKER_LEAKAGE_PROB=0.15
ORDERBOOK_FETCH_INTERVAL_SEC=5
ORDERBOOK_LEVELS_LIMIT=10
MAKER_FEE_RATE_DEFAULT_DECIMAL=0.25
MAKER_FEE_RATE_BPS_DEFAULT=0
MAKER_ECON_FEE_RATE_DECIMAL=0
FEE_RATE_CACHE_TTL_SEC=300
FEE_RATE_FETCH_INTERVAL_SEC=300
FEE_LOG_INTERVAL_SEC=60
FEE_RATE_DEBUG=0
FEE_RATE_DEBUG_INTERVAL_SEC=30
POLY_HTTP_MAX_RETRIES=4
POLY_HTTP_RETRY_INITIAL_MS=250
POLY_HTTP_RETRY_MAX_MS=2000

# =========================
# Hold-to-redeem / 0.97 TP
# =========================
HOLD_TO_REDEEM=1
TAIL_PROTECT_TP_ENABLED=1
TAIL_PROTECT_TP_PRICE=0.97
TAIL_PROTECT_TP_FRACTION=1.00
TAIL_PROTECT_TP_MIN_ENTRY_PRICE=0.55

# Hold normally until redemption. A taker recovery exit is permitted only after
# the locked side has been confirmed invalidated; it is not a price-drop stop.
TAKER_EXIT_ENABLED=1
TAKER_EXIT_ONLY_AFTER_INVALIDATION=1
# Recovery needs a fresh adverse 60s TWAP confirmation, not a one-tick move.
TAKER_EXIT_REQUIRE_TWAP_CONFIRMATION=1
# Allow recovery only within the final 12 minutes, after invalidation confirmation.
TAKER_EXIT_MAX_TIME_LEFT_SEC=720
# Require both a minimum executable bid and at least 50% cost recovery.
TAKER_EXIT_MIN_BID=0.15
TAKER_EXIT_MIN_RECOVERY_RATIO=0.50
# Never recover-exit immediately after a fill, even if invalidation is confirmed.
TAKER_EXIT_MIN_HOLD_SEC=120
TAKER_EXIT_REQUIRE_INVENTORY=1
TAKER_EXIT_DISABLE_IF_BID_BELOW=0.10
CATASTROPHIC_STOP_LOSS_ENABLED=0
ABSOLUTE_MAX_LOSS_ENABLED=0

# =========================
# Inventory / sell balance recovery
# =========================
MAKER_BALANCE_CHECK_INTERVAL_SEC=30
CONDITIONAL_BALANCE_CHECK_INTERVAL_SEC=8
CONDITIONAL_BALANCE_SAFETY_BUFFER_PCT=0.001
SELLABLE_FALLBACK_AFTER_BUY_SEC=10
SELLABLE_AFTER_BUY_BUFFER_SHARES=0.05
SELL_RECOVERY_QTY_BUFFER_SHARES=0.01
SELL_DELAY_AFTER_BUY_SEC=10.0
SELL_BALANCE_RETRY_PAUSE_SEC=3.0
TRAPPED_INVENTORY_RECOVERY_ENABLED=1
TRAPPED_INVENTORY_RECOVERY_MIN_QTY=1.0
TRAPPED_INVENTORY_RECOVERY_MAX_ROBUST_NET_DEFICIT_USDC=0.05

# =========================
# Risk guard
# =========================
REGIME_GUARD_ENABLED=1
REGIME_GUARD_N_MARKETS=4
REGIME_GUARD_TRIGGER_SUM_PNL_USDC=-2.0
REGIME_GUARD_COOLDOWN_SEC=3600
REGIME_GUARD_MIN_NEGATIVE_MARKETS=3
REGIME_GUARD_BOOTSTRAP_LOOKBACK_MARKETS=12

# =========================
# Quote health
# =========================
QUOTE_HEALTHCHECK_INTERVAL_SEC=10
QUOTE_STALE_SEC=30
# Shadow telemetry only: accept small exchange/local event-clock differences.
QUOTE_EVENT_CLOCK_SKEW_TOLERANCE_SEC=0.25
QUOTE_INVALID_TICK_RELOAD_THRESHOLD=80
QUOTE_RELOAD_COOLDOWN_SEC=60
# After a forced resubscribe, rebuild the node if no fresh quote arrives in this window.
QUOTE_RESUBSCRIBE_GRACE_SEC=12
STALE_QUOTE_SYNTH_MAX_AGE_SEC=10

# =========================
# Optional metrics / maintenance
# =========================
GRAFANA_EXPORTER_HOST=127.0.0.1
GRAFANA_EXPORTER_PORT=8000
AUTO_REDEEM_ENABLED=1
AUTO_REDEEM_APPLY=1
AUTO_REDEEM_INTERVAL_SEC=900
AUTO_REDEEM_ON_ROLLOVER=1
AUTO_REDEEM_TIMEOUT_SEC=180
AUTO_REDEEM_MIN_GAP_SEC=300
AUTO_REDEEM_SLUG_FILTER=btc-updown-15m
AUTO_REDEEM_MIN_CONDITION_SIZE=0.0
AUTO_REDEEM_MIN_TOTAL_SIZE=0.0

# =========================
# Telegram通知系統
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Set to 0 on any second host that shares this bot token; notifications still send.
TELEGRAM_CONTROLLER_ENABLED=1
# Host-local safeguards. A shared Telegram token still requires one polling host.
TELEGRAM_POLLING_LOCK_PATH=/tmp/polymarket-btc-15m-telegram-polling.lock
LIVE_PROCESS_LOCK_PATH=/tmp/polymarket-btc-15m-live.lock
ALERT_CONSECUTIVE_LOSSES=3
ALERT_LARGE_LOSS_USD=1.50
ALERT_LOW_BALANCE_USD=20.00
ALERT_HEARTBEAT_STALE_SEC=300
