# =========================
# Polymarket API credentials
# =========================
POLYMARKET_PK=
# Optional (can be auto-derived from POLYMARKET_PK)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
# Optional funder address if your setup requires it
POLYMARKET_FUNDER=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CHAIN_ID=137
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
GAMMA_DISCOVERY_TIMEOUT_SEC=8
BTC_MARKET_LOOKBACK_INTERVALS=1
BTC_MARKET_LOOKAHEAD_INTERVALS=4
BTC_MARKET_LOAD_SLUG_COUNT=3
BTC_MARKET_END_WINDOW_BACK_MINUTES=5
BTC_MARKET_END_WINDOW_FORWARD_MINUTES=120

# =========================
# Redis (mode switching)
# =========================
# Keep Redis on localhost if possible
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
# Optional ACL username
REDIS_USERNAME=
# Strongly recommended if Redis is not localhost
REDIS_PASSWORD=

# =========================
# Grafana dashboard importer
# =========================
# Required by grafana/import_dashboard.py
GRAFANA_USER=
GRAFANA_PASS=

# =========================
# Metrics exporter (Prometheus/Grafana scrape)
# =========================
# Security default: local-only bind
GRAFANA_EXPORTER_HOST=127.0.0.1
GRAFANA_EXPORTER_PORT=8000

# =========================
# Strategy parameters
# =========================
MAX_POSITION_SIZE=1.0
STOP_LOSS_PCT=0.30
TAKE_PROFIT_PCT=0.20
SPIKE_THRESHOLD=0.15
DIVERGENCE_THRESHOLD=0.05

# =========================
# Maker strategy controls
# =========================
MAKER_MODE=1
MAKER_QUOTE_REFRESH_SEC=5
MAKER_HALF_SPREAD=0.01
MAKER_QUOTE_SIZE_USDC=1.0
MAKER_MIN_SHARES=5
MAKER_FIXED_SHARES=0
MAKER_MAX_ORDER_USDC=1.0
# both=single token buy+sell, buy=single token buy only, sell=single token sell only,
# both_buy=Up/Down tokens in same market both BUY (5-share x2 style)
MAKER_QUOTE_SIDES=both
MAKER_POST_ONLY=0
MAKER_MIN_EXPECTED_NET_USDC=0.0001
MAKER_ADVERSE_SELECTION_BUFFER=0.0005
MAKER_POST_ONLY_STRICT=1
MAKER_MAX_INVENTORY_SHARES=25
MAKER_KILL_SWITCH_RESET_ON_ROLLOVER=1
MAKER_INVENTORY_SKEW_MAX=0.03
MAKER_VOL_PAUSE_THRESHOLD=0.03
MAKER_VOL_PAUSE_SEC=30
MAKER_VOL_WARMUP_QUOTES=30
MAKER_VOL_RETURN_CLIP=0.20
MAKER_VOL_ROLLING_WINDOW=30
MAKER_VOL_EWMA_ALPHA=0.35
MAKER_VOL_REAL_HISTORY_MAX=300
QUOTE_HEALTHCHECK_INTERVAL_SEC=10
STRATEGY_STATUS_INTERVAL_SEC=30
QUOTE_STALE_SEC=30
QUOTE_INVALID_TICK_RELOAD_THRESHOLD=80
QUOTE_RELOAD_COOLDOWN_SEC=60
MAKER_MAX_CONSECUTIVE_DENIED=5
MAKER_ORDER_TTL_SEC=20
MAKER_REQUOTE_THRESHOLD=0.002
MAKER_CANCEL_COOLDOWN_SEC=2
MAKER_CANCEL_ACK_TIMEOUT_SEC=8
MAKER_CANCEL_MAX_RETRIES=3
MAKER_SIMULATION_SHADOW=1
MAKER_SIM_EVAL_SEC=60
SIM_ACK_LATENCY_MS_MIN=120
SIM_ACK_LATENCY_MS_MAX=800
SIM_CANCEL_LATENCY_MS_MIN=80
SIM_CANCEL_LATENCY_MS_MAX=500
SIM_FILL_BASE_PROB=0.08
SIM_FILL_EDGE_BOOST=0.30
SIM_FILL_QUEUE_PENALTY=0.45
SIM_FILL_AGE_BONUS_MAX=0.25
SIM_FILL_AGE_TO_MAX_SEC=25
SIM_PARTIAL_FILL_MIN_RATIO=0.2
SIM_PARTIAL_FILL_MAX_RATIO=1.0
MAKER_BALANCE_PAUSE_SEC=30
MAKER_ERROR_PAUSE_SEC=30
MAKER_FEE_RATE_DEFAULT_DECIMAL=0.25
MAKER_FEE_RATE_BPS_DEFAULT=0
MAKER_AUTO_TUNE=1
MAKER_AUTO_TUNE_INTERVAL_SEC=300
EXTERNAL_SPOT_TIMEOUT_SEC=2.5
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
FEE_RATE_CACHE_TTL_SEC=300
FEE_RATE_DEBUG=1
FEE_RATE_DEBUG_INTERVAL_SEC=30
REBATE_REPORT_DIR=./logs/rebate

# =========================
# Auto redeem (non-blocking background worker)
# =========================
AUTO_REDEEM_ENABLED=0
AUTO_REDEEM_APPLY=0
AUTO_REDEEM_INTERVAL_SEC=900
AUTO_REDEEM_ON_ROLLOVER=1
AUTO_REDEEM_TIMEOUT_SEC=180
AUTO_REDEEM_SLUG_FILTER=btc-updown-15m

# =========================
# Trade journal DB
# =========================
TRADE_DB_ENABLED=1
TRADE_DB_PATH=./logs/trade_journal.db

# =========================
# Long-run node rollover (24hr operation)
# =========================
AUTO_NODE_ROLLOVER_ENABLED=1
AUTO_NODE_ROLLOVER_SEC=1800
AUTO_NODE_ROLLOVER_COOLDOWN_SEC=3
AUTO_NODE_ROLLOVER_MAX_FAILURES=5
AUTO_NODE_RESTART_ON_UNEXPECTED_EXIT=0

# Auto re-apply local Nautilus patch (quote drop warning throttling) on startup
AUTO_APPLY_NAUTILUS_PATCH=1

# Momentum Filter: Block buy on drop / sell on pump
MAKER_MOMENTUM_FILTER_PCT=0.03
MAKER_MOMENTUM_WINDOW_TICKS=20

# Fair pricer mode: drift (legacy) or digital (short-dated digital option)
MAKER_FAIR_PRICER_MODE=drift
MAKER_DIGITAL_VOL_WINDOW=120
MAKER_DIGITAL_VOL_MIN_POINTS=20
MAKER_DIGITAL_SIGMA_DEFAULT=0.60
MAKER_DIGITAL_SIGMA_FLOOR=0.20
MAKER_DIGITAL_SIGMA_CEILING=2.00
MAKER_DIGITAL_VOL_SCALE=1.00
EXTERNAL_SPOT_HISTORY_MAX=1200
