                f"fill_rate={_fmt_pct(fill_rate_run)} reject_rate={_fmt_pct(reject_rate_run)} "
                f"commission={_fmt_num(float(r['commission_total'] or 0.0), 4)} "
                f"first={r['first_ts']} last={r['last_ts']}"
            )

