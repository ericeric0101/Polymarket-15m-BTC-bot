            f = int(r["fills"] or 0)
            rej = int(r["rejects"] or 0)
            tx = int(r["taker_exit_submits"] or 0)
            fill_rate_run = (f / s) if s > 0 else None
            reject_rate_run = (rej / s) if s > 0 else None
            print(
