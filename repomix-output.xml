            + "            method=method,\n"
            + "            url=endpoint,\n"
            + "            headers=headers,\n"
            + "            content=data.encode(\"utf-8\"),\n"
            + "        )\n"
            + "    return client.request(\n"
            + "        method=method,\n"
            + "        url=endpoint,\n"
            + "        headers=headers,\n"
            + "        json=data,\n"
            + "    )\n",
            1,
        )

