venv/bin/python scripts/check_positions_and_redeem.py --slug btc-updown-15m

# 2) 找到 redeemable=true 後，直接鏈上 redeemPositions
venv/bin/python scripts/check_positions_and_redeem.py --slug btc-updown-15m --apply
