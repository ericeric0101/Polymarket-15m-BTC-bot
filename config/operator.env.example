# Operator-level BTC 15-minute bot configuration.
#
# This is the supported day-to-day surface. Leave advanced timing, retry,
# telemetry, and experimental knobs at application defaults unless a replay
# comparison justifies changing them. Do not replace a working legacy .env
# with this file without first comparing settings via inspect_env_contract.py.

# Credentials and venue
POLYMARKET_PK=
POLYMARKET_WALLET_ADDRESS=
POLYGON_RPC_URL=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CTF_COLLATERAL_TOKEN=PUSD

# Runtime and research telemetry
TRADE_DB_ENABLED=1
TRADE_DB_PATH=./logs/trade_journal.db
AUTO_NODE_ROLLOVER_ENABLED=1
AUTO_NODE_ROLLOVER_SEC=3600
AUTO_NODE_RESTART_ON_UNEXPECTED_EXIT=1
FAIR_EDGE_BUCKET_SHADOW_ENABLED=1
SHADOW_SIMULATION_ENABLED=1
DASHBOARD_THEME=light

# Position sizing: standard / reduced tier
MAKER_MODE=1
MAKER_QUOTE_SIDES=both
MAKER_FIXED_SHARES=10
MAKER_MIN_SHARES=5
MAKER_EXCHANGE_MIN_SHARES=5
MAKER_MAX_ORDER_USDC=12
MAKER_MAX_INVENTORY_SHARES=10
MAX_LOCKED_SIDE_POSITION=10
MARKET_MAX_BUY_EVENTS_PER_MARKET=2
MAKER_WEAK_PFAIR_SIZE_ADJUST_ENABLED=1
MAKER_WEAK_PFAIR_SIZE_ADJUST_MULTIPLIER=0.5
MAKER_HIGH_ENTRY_PRICE_SIZE_ADJUST_ENABLED=1
MAKER_HIGH_ENTRY_PRICE_SIZE_ADJUST_THRESHOLD=0.70
MAKER_HIGH_ENTRY_PRICE_SIZE_ADJUST_MULTIPLIER=0.5

# Entry chain: direction, model consistency, and common economics
DIRECTIONAL_ENTRY_MIN_SCORE_ABS_NEW=0.20
DIRECTIONAL_FIRST_ENTRY_MIN_SCORE_ABS_NEW=0.20
FIRST_ENTRY_MAX_TIME_LEFT_SEC=720
ENTRY_FAIR_EDGE_MIN_PS=0.002
MAKER_MIN_EXPECTED_NET_USDC=0.001
EXTERNAL_ENTRY_CONFIRMATION_ENABLED=1
EXTERNAL_ENTRY_CONFIRMATION_SKIP_STRONG_CONFLICT=1
PROBABILITY_CALIBRATION_ENABLED=1
PROBABILITY_CALIBRATION_UP_MODEL_WEIGHT=0.65
PROBABILITY_CALIBRATION_DOWN_MODEL_WEIGHT=0.35
TREND_BUY_ENABLED=1
TREND_BUY_MIN_SCORE=0.16
TREND_BUY_MIN_TIME_LEFT_SEC=360

# Side decision and settlement-aligned reference data
BI_SIDE_ENABLED=1
BI_SIDE_DECISION_GRACE_SEC=60
BI_SIDE_ALLOW_INTRAMARKET_FLIP=1
SIDE_SIGNAL_MIN_CONFIDENCE=0.15
SIDE_SIGNAL_BTC_TREND_PRIMARY_STALE_SEC=10
MAKER_FAIR_PRICER_MODE=digital
POLYMARKET_CHAINLINK_TWAP_ENABLED=1
POLYMARKET_CHAINLINK_TWAP_WINDOW_SEC=60
REQUIRE_TWAP_REFERENCE_SPOT=1
TWAP_DEGRADED_BLOCK_NEW_ENTRIES=1

# Single execution-cost model
MAKER_EXECUTION_PENALTY_ENABLE=1
MAKER_EXECUTION_PENALTY_FLOOR_USDC=0.001
MAKER_EXECUTION_VWAP_ENTRY_RISK_WEIGHT=0.25
MAKER_EXECUTION_EMPIRICAL_MARKOUT_ENABLE=1
MAKER_EXECUTION_EMPIRICAL_MARKOUT_MIN_SAMPLES=5

# Exit authority
HOLD_TO_REDEEM=1
TAIL_PROTECT_TP_ENABLED=1
TAIL_PROTECT_TP_PRICE=0.97
TAKER_EXIT_ENABLED=1
TAKER_EXIT_ONLY_AFTER_INVALIDATION=1
TAKER_EXIT_REQUIRE_TWAP_CONFIRMATION=1
TAKER_EXIT_MAX_TIME_LEFT_SEC=720
TAKER_EXIT_MIN_RECOVERY_RATIO=0.50
